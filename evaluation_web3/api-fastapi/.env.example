# Copier en .env et adapter

# Option A — PostgreSQL (Docker : infra/ puis port 15432 sur l’hôte)
DATABASE_URL=postgresql://certichain:certichain_secret@localhost:15432/certichain

# Option B — SQLite, fichier local (aucun conteneur requis ; dossier data/ créé au besoin)
# DATABASE_URL=sqlite:///./data/certichain.db

CORS_ORIGINS=http://localhost:3000,http://localhost:3001
