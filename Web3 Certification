<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Evaluation Web3</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 p-6">

    <div class="max-w-4xl mx-auto">
        <header class="mb-10 border-b pb-4">
            <h1 class="text-4xl font-extrabold text-slate-900">CertiChain <span class="text-indigo-600">.io</span></h1>
            <p class="text-slate-500">Evaluation web3 </p>
        </header>

        <div class="bg-white p-8 rounded-2xl shadow-sm border border-slate-200 mb-8">
            <h2 class="text-xl font-bold text-slate-800 mb-6">Informations du Certificat</h2>
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Prénom de l'étudiant</label>
                    <input type="text" id="firstName" placeholder="ex: Jean" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nom de l'étudiant</label>
                    <input type="text" id="lastName" placeholder="ex: DUPONT" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>

                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Intitulé de la certification [cite: 30]</label>
                    <input type="text" id="certTitle" placeholder="ex: Licence Informatique" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Date d'émission [cite: 31]</label>
                    <input type="date" id="issueDate" class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Hash de preuve Blockchain [cite: 32]</label>
                    <input type="text" id="txHash" placeholder="0x71c..." class="w-full p-3 border rounded-xl focus:ring-2 focus:ring-indigo-500 outline-none">
                </div>
            </div>

            <button id="addBtn" class="w-full mt-8 bg-indigo-600 text-white py-4 rounded-xl font-bold text-lg hover:bg-indigo-700 shadow-lg shadow-indigo-200 transition-all">
                Signer et Publier le Certificat
            </button>
        </div>

        <div id="certList" class="space-y-4">
            </div>
    </div>

    <script>
        const addBtn = document.getElementById('addBtn');
        const certList = document.getElementById('certList');

        addBtn.addEventListener('click', () => {
            const first = document.getElementById('firstName').value;
            const last = document.getElementById('lastName').value;
            const title = document.getElementById('certTitle').value;
            const date = document.getElementById('issueDate').value;
            const hash = document.getElementById('txHash').value;
            const id = "ID-" + Math.random().toString(36).substr(2, 9).toUpperCase(); // Identifiant unique [cite: 28]

            if (!first || !last || !title || !date || !hash) {
                alert("Erreur : Tous les champs du certificat sont obligatoires.");
                return;
            }

            const card = document.createElement('div');
            card.className = "bg-white p-6 rounded-2xl border border-slate-200 shadow-sm hover:shadow-md transition-shadow flex justify-between items-start";
            card.innerHTML = `
                <div class="flex-1">
                    <div class="flex items-center gap-3 mb-2">
                        <span class="px-2 py-1 bg-slate-100 text-slate-600 text-xs font-bold rounded">${id}</span>
                        <span class="text-emerald-500 text-xs font-bold flex items-center gap-1">
                            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20"><path d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"></path></svg>
                            Vérifié sur Blockchain
                        </span>
                    </div>
                    <h3 class="text-xl font-bold text-slate-900">${title}</h3>
                    <p class="text-slate-700 mt-1">Titulaire : <span class="font-semibold">${first} ${last}</span> </p>
                    <p class="text-sm text-slate-500">Émis le : ${date}</p>
                    <div class="mt-4 flex items-center gap-2">
                        <code class="text-[10px] bg-slate-50 p-2 rounded block text-slate-400 border border-dashed truncate w-full max-w-md">
                            Proof-Hash: ${hash}
                        </code>
                    </div>
                </div>
                <button class="del-btn text-slate-300 hover:text-red-500 transition-colors p-2">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"></path></svg>
                </button>
            `;

            // Gestion de la suppression
            card.querySelector('.del-btn').addEventListener('click', () => card.remove());

            certList.prepend(card);

            // Reset des champs
            document.querySelectorAll('input').forEach(input => input.value = '');
        });
    </script>
</body>
</html>
